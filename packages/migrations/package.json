    "migrate:status": "tsx src/migrate.ts status"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
