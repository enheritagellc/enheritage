PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_MEDIA=enheritage-media-dev
SQS_ENRICHMENT_QUEUE_URL=http://localhost:4566/000000000000/enheritage-enrichment-dev
SQS_BIOGRAPHY_QUEUE_URL=http://localhost:4566/000000000000/enheritage-biography-dev

# Redis
REDIS_URL=redis://localhost:6379

# External APIs (leave blank in dev to skip those providers)
GOOGLE_MAPS_API_KEY=
NEWS_API_KEY=

# Tuning
MAX_ENTITIES_PER_JOB=50
PROVIDER_CONCURRENCY=5
CACHE_TTL_SECONDS=86400
