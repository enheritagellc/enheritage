PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://enheritage:enheritage_dev@localhost:5432/enheritage

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

SQS_NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/enheritage-notification-dev

# SES — set a verified sender address for real email delivery
SES_FROM_ADDRESS=noreply@enheritage.com
SES_FROM_NAME=Enheritage

# SMS via SNS (optional)
SNS_SMS_ENABLED=false

# Set to true to suppress all real sends (log only)
DRY_RUN=true
