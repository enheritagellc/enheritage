{
  "expo": {
    "name": "Enheritage",
    "slug": "enheritage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "enheritage",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.enheritage.app" },
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png" }, "package": "com.enheritage.app" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
